# Скопировать в backend/.env (он не попадает в git) и заполнить. База — npm run dev:db в корне.
DATABASE_URL=postgres://ayzonexam:ayzonexam@localhost:5433/ayzonexam?sslmode=disable
ADDR=:8080

# Локально без бота: вход без Telegram в обычном браузере (npm run dev:web).
DEV_AUTH=1
BOT_MODE=off

# Проверка Writing. Без ключа — заглушка (только локально). Ключ: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts   # озвучка сценариев Listening в админке
# GEMINI_DAILY_LIMIT=20   # бесплатный ключ: не больше 20 запросов в сутки на модель, сверх — проверки ждут
# WRITING_DAILY_LIMIT=3   # проверок Writing в день с Premium (без Premium — 2 в неделю)
# WRITING_WORKERS=3       # проверок Writing одновременно
# SPEAKING_WORKERS=2      # проверок Speaking одновременно

# Админка: Telegram id владельца и помощников через запятую (узнать свой id — @userinfobot).
# ADMIN_IDS=
# Оплата Premium переводом на карту (страница /pay). Пусто — кнопка оплаты пишет «недоступно».
# PAY_CARD=8600 0000 0000 0000
# PAY_CARD_NAME=Имя Фамилия

# С ботом из BotFather (проверка на телефоне через туннель, см. README):
# BOT_TOKEN=
# BOT_MODE=polling
# WEBAPP_URL=https://<адрес туннеля>
# WEB_DIR=../frontend/dist

# На сервере (этап 7):
# BOT_MODE=webhook
# PUBLIC_URL=https://exam.example.uz
# WEBHOOK_SECRET=   # 32+ случайных символа
