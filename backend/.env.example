# Скопировать в backend/.env (он не попадает в git) и заполнить. База — npm run dev:db в корне.
DATABASE_URL=postgres://ayzonexam:ayzonexam@localhost:5433/ayzonexam?sslmode=disable
ADDR=:8080

# Локально без бота: вход без Telegram в обычном браузере (npm run dev:web).
DEV_AUTH=1
BOT_MODE=off

# С ботом из BotFather (проверка на телефоне через туннель, см. README):
# BOT_TOKEN=
# BOT_MODE=polling
# WEBAPP_URL=https://<адрес туннеля>
# WEB_DIR=../frontend/dist

# На сервере (этап 7):
# BOT_MODE=webhook
# PUBLIC_URL=https://exam.example.uz
# WEBHOOK_SECRET=   # 32+ случайных символа
