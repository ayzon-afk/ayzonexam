# Настройки сервера AYZON EXAM. Создаётся командой ./make-env.sh <поддомен> — пароли случайные.
# deploy/.env не попадает в git; сохраните его копию у себя.

# Поддомен приложения, например exam.ayzon.uz — адрес Mini App и webhook бота
EXAM_DOMAIN=
# Пароль базы и секрет webhook — заполняет make-env.sh
POSTGRES_PASSWORD=
WEBHOOK_SECRET=

# Бот из BotFather (тот же, что при проверке, или новый боевой)
BOT_TOKEN=
# Telegram id владельца и помощников через запятую: админка и сообщения о сервере
ADMIN_IDS=
# Платный ключ Gemini (ROADMAP, этап 7)
GEMINI_API_KEY=
# Карта для переводов учеников
PAY_CARD=
PAY_CARD_NAME=

# Копии вне сервера — Cloudflare R2 (пусто — копии только на сервере)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Образы: по умолчанию последние из GitHub (ghcr.io/ayzon-afk/ayzon-exam, …-backup)
# APP_IMAGE=
# BACKUP_IMAGE=
